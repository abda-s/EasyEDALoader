ClientInsFile 1.0

Server
    EditorName        = 'EasyEDA-Loader'                                                                   
    EditorExePath     = 'EasyEDA-Loader.DLL'                                                               
    EditorDescription = 'This server draws footprints from datasheet package data.'                                            
    Version           = 'Version 1.0.0.0'                                                      
    Date              = '06-June-2025'                                                             
    HelpAboutInfo     = 'This software is protected by copyright law and international treaties.' 
    Copyright         = 'Copyright Expired 2025' 
    Updates           = 'AdvSch'
    SystemExtension   = True
End

Command Name = 'EasyEDARun'      LongSummary = 'Loads EasyEDA component from server' End
Command Name = 'EasyEDAImport'   LongSummary = 'Imports LCSC parts by number without the dialog (Parts=C1,C2|Place=True)' End